# Copy to .env.local (git-ignored) and adjust for your machine.
# Gateway base URL. Use your LAN IP for a physical device, or http://10.0.2.2:3000 on the Android emulator.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Optional: raster tile source for the order-screen map ({z}/{x}/{y} template) and its attribution.
# The default OpenStreetMap tiles are for light use only; use a proper tile provider in production.
# EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
